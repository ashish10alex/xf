      "signatures": [
        {
          "params": [
            {
              "name": "expression",
              "type": ""
            }
          ],
          "returns": "same type"
        }
      ],
      "window": "optional",
      "example": {
        "sql": "MAX(x)",
        "result": "3, for x = 3, 1, NULL"
