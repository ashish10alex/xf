    },
    {
      "name": "ROW_NUMBER",
      "doc": "Numbers each partition's rows 1, 2, 3, … in ORDER BY's order.",
      "signatures": [
        {
          "params": [],
          "returns": "INT64"
        }
      ],
      "window": "required",
      "example": {
        "sql": "QUALIFY ROW_NUMBER() OVER (PARTITION BY id ORDER BY updated_at DESC) = 1",
        "result": "the latest row of each id"
      },
      "url": "https://cloud.google.com/bigquery/docs/reference/standard-sql/numbering_functions#row_number"
    },
    {
      "name": "RANK",
      "doc": "Ranks each partition's rows; ties share a rank and leave a gap.",
      "signatures": [
        {
          "params": [],
          "returns": "INT64"
        }
      ],
      "window": "required",
      "example": {
        "sql": "RANK() OVER (ORDER BY score DESC)",
        "result": "1, 1, 3, for scores 9, 9, 7"
      },
      "url": "https://cloud.google.com/bigquery/docs/reference/standard-sql/numbering_functions#rank"
    },
    {
      "name": "DENSE_RANK",
      "doc": "Ranks each partition's rows; ties share a rank and leave no gap.",
      "signatures": [
        {
          "params": [],
          "returns": "INT64"
        }
      ],
      "window": "required",
      "example": {
        "sql": "DENSE_RANK() OVER (ORDER BY score DESC)",
        "result": "1, 1, 2, for scores 9, 9, 7"
      },
      "url": "https://cloud.google.com/bigquery/docs/reference/standard-sql/numbering_functions#dense_rank"
    },
    {
      "name": "NTILE",
      "doc": "Splits each partition's rows into n near-equal buckets, and returns the row's bucket, from 1.",
      "signatures": [
        {
          "params": [
            {
              "name": "n",
              "type": ""
            }
          ],
          "returns": "INT64"
        }
      ],
      "window": "required",
      "example": {
        "sql": "NTILE(4) OVER (ORDER BY score)",
        "result": "the row's quartile, 1 to 4"
      },
      "url": "https://cloud.google.com/bigquery/docs/reference/standard-sql/numbering_functions#ntile"
    },
    {
      "name": "LAG",
      "doc": "Returns value from the row offset rows before (1 unless you give one), or default (NULL) when there is none.",
      "signatures": [
        {
          "params": [
            {
              "name": "value",
              "type": ""
            },
            {
              "name": "offset",
              "type": "",
              "optional": true
            },
            {
              "name": "default",
              "type": "",
              "optional": true
            }
          ],
          "returns": "same type"
        }
      ],
      "window": "required",
      "example": {
        "sql": "LAG(amount) OVER (PARTITION BY customer ORDER BY day)",
        "result": "the customer's amount on the row before"
      },
      "url": "https://cloud.google.com/bigquery/docs/reference/standard-sql/navigation_functions#lag"
    },
    {
      "name": "LEAD",
      "doc": "Returns value from the row offset rows after (1 unless you give one), or default (NULL) when there is none.",
      "signatures": [
        {
          "params": [
            {
              "name": "value",
              "type": ""
            },
            {
              "name": "offset",
              "type": "",
              "optional": true
            },
            {
              "name": "default",
              "type": "",
              "optional": true
            }
          ],
          "returns": "same type"
        }
      ],
      "window": "required",
      "example": {
        "sql": "LEAD(amount) OVER (PARTITION BY customer ORDER BY day)",
        "result": "the customer's amount on the row after"
      },
      "url": "https://cloud.google.com/bigquery/docs/reference/standard-sql/navigation_functions#lead"
    },
    {
      "name": "FIRST_VALUE",
      "doc": "Returns value from the first row of the window frame.",
      "signatures": [
        {
          "params": [
            {
              "name": "value",
              "type": ""
            },
            {
              "name": "NULLS",
              "type": "",
              "before": "IGNORE",
              "optional": true
            }
          ],
          "returns": "same type"
        }
      ],
      "window": "required",
      "example": {
        "sql": "FIRST_VALUE(status) OVER (PARTITION BY id ORDER BY ts)",
        "result": "each id's first status"
      },
      "url": "https://cloud.google.com/bigquery/docs/reference/standard-sql/navigation_functions#first_value"
    },
    {
      "name": "LAST_VALUE",
      "doc": "Returns value from the last row of the window frame. With ORDER BY the frame ends at the current row, so widen it as the example does.",
      "signatures": [
        {
          "params": [
            {
              "name": "value",
              "type": ""
            },
            {
              "name": "NULLS",
              "type": "",
              "before": "IGNORE",
              "optional": true
            }
          ],
          "returns": "same type"
        }
      ],
      "window": "required",
      "example": {
        "sql": "LAST_VALUE(status) OVER (PARTITION BY id ORDER BY ts ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING)",
        "result": "each id's last status"
      },
      "url": "https://cloud.google.com/bigquery/docs/reference/standard-sql/navigation_functions#last_value"
    },
    {
      "name": "NTH_VALUE",
      "doc": "Returns value from the nth row of the window frame, from 1.",
      "signatures": [
        {
          "params": [
            {
              "name": "value",
              "type": ""
            },
            {
              "name": "n",
              "type": ""
            }
          ],
          "returns": "same type"
        }
      ],
      "window": "required",
      "example": {
        "sql": "NTH_VALUE(name, 2) OVER (ORDER BY score DESC)",
        "result": "the second-best name (NULL on the first row)"
      },
      "url": "https://cloud.google.com/bigquery/docs/reference/standard-sql/navigation_functions#nth_value"
    },
    {
      "name": "PERCENTILE_CONT",
      "doc": "Returns a percentile of value in each partition, from 0 to 1; 0.5 is the median.",
      "signatures": [
        {
          "params": [
            {
              "name": "value",
              "type": ""
            },
            {
              "name": "percentile",
              "type": ""
            }
          ],
          "returns": "FLOAT64"
        }
      ],
      "window": "required",
      "over": "PARTITION BY {partition_expr}",
      "example": {
        "sql": "PERCENTILE_CONT(price, 0.5) OVER (PARTITION BY category)",
        "result": "each category's median price"
      },
      "url": "https://cloud.google.com/bigquery/docs/reference/standard-sql/navigation_functions#percentile_cont"
    },
    {
      "name": "DATE_TRUNC",
      "doc": "Rounds a date down to the start of its granularity. WEEK starts on Sunday, WEEK(MONDAY) on Monday.",
      "signatures": [
        {
          "params": [
            {
              "name": "date_value",
              "type": ""
            },
            {
              "name": "granularity",
              "type": "",
              "values": "date_granularity"
            }
          ],
          "returns": "same type"
        }
      ],
      "example": {
        "sql": "DATE_TRUNC(DATE '2023-12-13', MONTH)",
        "result": "2023-12-01"
      },
      "url": "https://cloud.google.com/bigquery/docs/reference/standard-sql/date_functions#date_trunc"
    },
    {
      "name": "DATETIME_TRUNC",
      "doc": "Rounds a datetime down to the start of its granularity.",
      "signatures": [
        {
          "params": [
            {
              "name": "datetime_value",
              "type": ""
            },
            {
              "name": "granularity",
              "type": "",
              "values": "datetime_granularity"
            }
          ],
          "returns": "DATETIME"
        }
      ],
      "example": {
        "sql": "DATETIME_TRUNC(DATETIME '2024-03-31 12:34:56', HOUR)",
        "result": "2024-03-31T12:00:00"
      },
      "url": "https://cloud.google.com/bigquery/docs/reference/standard-sql/datetime_functions#datetime_trunc"
    },
    {
      "name": "TIMESTAMP_TRUNC",
      "doc": "Rounds a timestamp down to the start of its granularity, in UTC unless you give a time zone.",
      "signatures": [
        {
          "params": [
            {
              "name": "timestamp_value",
              "type": ""
            },
            {
              "name": "granularity",
              "type": "",
              "values": "datetime_granularity"
            },
            {
              "name": "time_zone",
              "type": "",
              "optional": true
            }
          ],
          "returns": "TIMESTAMP"
        }
      ],
      "example": {
        "sql": "TIMESTAMP_TRUNC(TIMESTAMP '2024-03-31 12:34:56 UTC', DAY)",
        "result": "2024-03-31 00:00:00 UTC"
