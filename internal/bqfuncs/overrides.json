{
  "$comment": "xf's own, in bigquery-functions.json's format: each entry takes the place of the catalog's (or a borrowed snippet's) function of its name, for a short card: its call with the optional parts in brackets, a sentence and an example. A param with no type is its name alone in the signature; values may name the catalog's value sets.",
  "valueSets": {},
  "functions": [
    {
      "name": "ARRAY_AGG",
      "doc": "Collects a group's values into an array. It fails on a NULL unless you add IGNORE NULLS.",
      "signatures": [
        {
          "params": [
            {
              "name": "[DISTINCT] expression",
              "type": "",
              "snippet": "{expression}"
            },
            {
              "name": "NULLS",
              "type": "",
              "before": "IGNORE",
              "optional": true
            },
            {
              "name": "key",
              "type": "",
              "before": "ORDER BY",
              "optional": true
            },
            {
              "name": "n",
              "type": "",
              "before": "LIMIT",
              "optional": true
            }
          ],
          "returns": "ARRAY"
        }
      ],
      "example": {
        "sql": "ARRAY_AGG(fruit ORDER BY fruit)",
        "result": "['apple', 'banana', 'cherry']"
      },
      "url": "https://cloud.google.com/bigquery/docs/reference/standard-sql/aggregate_functions#array_agg"
    },
    {
      "name": "STRING_AGG",
      "doc": "Joins a group's values into one string, with ',' between them unless you give a delimiter.",
      "signatures": [
        {
          "params": [
            {
              "name": "[DISTINCT] expression",
              "type": "",
              "snippet": "{expression}"
            },
            {
              "name": "delimiter",
              "type": "",
              "optional": true
            },
            {
              "name": "key",
              "type": "",
              "before": "ORDER BY",
              "optional": true
            },
            {
              "name": "n",
              "type": "",
              "before": "LIMIT",
              "optional": true
            }
          ],
          "returns": "STRING"
        }
      ],
      "window": "optional",
      "example": {
        "sql": "STRING_AGG(fruit, ', ' ORDER BY fruit)",
        "result": "'apple, banana, cherry'"
      },
      "url": "https://cloud.google.com/bigquery/docs/reference/standard-sql/aggregate_functions#string_agg"
    },
    {
      "name": "COUNT",
      "doc": "Counts rows: COUNT(*) every row, COUNT(x) the rows where x is not NULL.",
      "signatures": [
        {
          "params": [
            {
              "name": "[DISTINCT] expression",
              "type": "",
              "snippet": "{expression}"
            }
          ],
          "returns": "INT64"
        }
      ],
      "window": "optional",
      "example": {
        "sql": "COUNT(DISTINCT customer_id)",
        "result": "the number of different customers"
      },
      "url": "https://cloud.google.com/bigquery/docs/reference/standard-sql/aggregate_functions#count"
    },
    {
      "name": "SUM",
      "doc": "Adds up the values that are not NULL; NULL when there are none.",
      "signatures": [
        {
          "params": [
            {
              "name": "[DISTINCT] expression",
              "type": "",
              "snippet": "{expression}"
            }
          ],
          "returns": "a number"
        }
      ],
      "window": "optional",
      "example": {
        "sql": "SUM(x)",
        "result": "3, for x = 1, 2, NULL"
      },
      "url": "https://cloud.google.com/bigquery/docs/reference/standard-sql/aggregate_functions#sum"
    },
    {
      "name": "AVG",
      "doc": "Averages the values that are not NULL.",
      "signatures": [
        {
          "params": [
            {
              "name": "[DISTINCT] expression",
              "type": "",
              "snippet": "{expression}"
            }
          ],
          "returns": "FLOAT64"
        }
      ],
      "window": "optional",
      "example": {
        "sql": "AVG(x)",
        "result": "1.5, for x = 1, 2, NULL"
      },
      "url": "https://cloud.google.com/bigquery/docs/reference/standard-sql/aggregate_functions#avg"
    },
