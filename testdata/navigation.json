                "schema": "analytics",
                "name": "dev_report",
                "database": "demo-project"
            },
            "query": "\n\nSELECT e.*, c.user_id AS helpers\nFROM `demo-project.analytics.dev_stg_events` e\nJOIN `demo-project.analytics.dev_stg_events` c USING (user_id)\nJOIN `demo-project.analytics.dev_stg_events` d USING (user_id)\nJOIN `demo-project.analytics.dev_js_view` v USING (user_id)\nJOIN raw-project.raw.events r USING (user_id)\nWHERE DATE(created_at) >= \"2026-01-01\" -- ${self()} is today's partition\n",
            "disabled": false,
            "fileName": "definitions/marts/report.sqlx",
            "bigquery": {
                "partitionBy": "DATE(created_at)"
            },
            "actionDescriptor": {
                "description": "Daily report of user events",
                "columns": [
                    {
                        "description": "The user who acted",
                        "path": [
                            "user_id"
                        ]
                    },
                    {
                        "description": "Raw event payload",
                        "path": [
                            "payload"
                        ]
                    },
                    {
                        "description": "What kind of event it was",
                        "path": [
                            "payload",
                            "kind"
                        ]
                    }
                ]
            },
