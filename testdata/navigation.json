        {
            "type": "view",
            "target": {
                "schema": "analytics",
                "name": "dev_stg_events",
                "database": "demo-project"
            },
            "query": "\n\n\n\nWITH filtered AS (\n  SELECT * FROM `raw-project.raw.events`\n  WHERE ts >= DATE_SUB(CURRENT_DATE(), INTERVAL 7 DAY) AND schema_name = \"analytics\"\n),\ncounted AS (\n  SELECT user_id, COUNT(*) AS n FROM filtered GROUP BY 1\n)\nSELECT *, 1 AS extra FROM counted\nWHERE n > 10\n",
            "disabled": false,
            "fileName": "definitions/staging/stg_events.sqlx",
