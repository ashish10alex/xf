{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "xf-dataform",
      "runtimeExecutable": "/opt/homebrew/bin/bash",
      "runtimeArgs": [
        "scripts/preview.sh",
        "dataform"
      ],
      "port": 7900,
      "autoPort": true
    },
    {
      "name": "xf-dbt",
      "runtimeExecutable": "/opt/homebrew/bin/bash",
      "runtimeArgs": [
        "scripts/preview.sh",
        "dbt"
      ],
      "port": 7901,
      "autoPort": true
    },
    {
      "name": "xf-dataform-embedded",
      "runtimeExecutable": "/opt/homebrew/bin/bash",
      "runtimeArgs": [
        "-c",
        "XF_PREVIEW_EMBEDDED=1 exec /opt/homebrew/bin/bash scripts/preview.sh dataform"
      ],
      "port": 7902,
      "autoPort": true
    }
  ]
}
