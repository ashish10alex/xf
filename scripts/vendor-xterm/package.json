{
  "name": "xf-vendor-xterm",
  "private": true,
  "description": "Builds internal/web/assets/vendor/xterm.mjs and xterm.css, the terminal tab of xf web: run `npm install && npm run build` here.",
  "scripts": {
    "build": "esbuild entry.js --bundle --minify --format=esm --target=es2022 --legal-comments=none --outfile=../../internal/web/assets/vendor/xterm.mjs && cp node_modules/@xterm/xterm/css/xterm.css ../../internal/web/assets/vendor/xterm.css"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0"
  },
  "devDependencies": {
    "esbuild": "0.25.4"
  }
}
